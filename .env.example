# Choose a discovered routes_*.toml file explicitly before the first deployment.
# Save that choice here to use plain `make deploy` thereafter. No provider default.
# ROUTES_FILE=routes_PROVIDER.toml

# Each credential name must match api_key_env in the selected provider file.
FIREWORKS_API_KEY=

# Non-secret shared affinity ID used by provider extra_headers when configured.
GLOBAL_SESSION_ID=your-shared-session-id
