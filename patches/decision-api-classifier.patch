+            Some("llm") => StageClassifierConfig::deserialize(toml::Value::Table(table))
+                .map(Self::Llm)
+                .map_err(serde::de::Error::custom),
+            Some("decision_api") => {
+                DecisionClassifierConfig::deserialize(toml::Value::Table(table))
+                    .map(Self::DecisionApi)
+                    .map_err(serde::de::Error::custom)
+            }
+            _ => Err(serde::de::Error::custom(
+                "composite classifier type must be llm or decision_api",
+            )),
+        }
+    }
