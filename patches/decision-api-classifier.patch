+/// A native `/v1/systemone` choice classifier. Confidence is a routing score,
+/// not a calibrated probability of the answering model's task success.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DecisionClassifierConfig {
+    /// Service root, `/v1`, or full `/v1/systemone` URL.
+    pub base_url: String,
+    /// Served decision model, independent from the answering tier models.
+    pub model: String,
+    /// Optional server-owned bearer credential. Caller credentials are never forwarded.
+    #[serde(default)]
+    pub api_key_env: Option<String>,
+    /// Total deadline including response-body reads, in milliseconds.
+    #[serde(default = "default_timeout")]
+    pub timeout_ms: u64,
+    /// Minimum efficient-choice probability; ambiguous decisions remain capable.
+    #[serde(default)]
+    pub efficient_threshold: Option<f64>,
+    /// User-turn/session classification frequency. Hash fallback is unsupported.
+    #[serde(default = "default_trigger")]
+    pub classify_trigger: ClassifyTrigger,
+    /// Recent messages following the preserved opening task.
+    #[serde(default = "default_window")]
+    pub recent_turn_window: usize,
+    /// Maximum serialized request bytes. Oversized context is not silently truncated.
+    #[serde(default = "default_request_bytes")]
+    pub max_request_bytes: usize,
+    /// Server context ceiling. A response at the ceiling may have been truncated.
+    #[serde(default = "default_input_tokens")]
+    pub max_input_tokens: u64,
+    /// Instructions explaining what to decide; conversation content is untrusted data.
+    pub instructions: String,
+    /// Whole-task criteria for the efficient answering tier.
+    #[serde(default)]
+    pub efficient_criteria: String,
+    /// Whole-task criteria for the capable answering tier.
+    #[serde(default)]
+    pub capable_criteria: String,
+    /// Criteria for missing context or uncertainty.
+    pub uncertain_criteria: String,
+    /// Named target choices. Replaces the legacy efficient/capable criteria.
+    #[serde(default)]
+    pub choices: BTreeMap<String, DecisionTargetConfig>,
+}
+
+const fn default_timeout() -> u64 {
+    2000
+}
+const fn default_threshold() -> f64 {
+    0.9
+}
+const fn default_trigger() -> ClassifyTrigger {
+    ClassifyTrigger::UserTurn
+}
+const fn default_window() -> usize {
+    6
+}
+const fn default_request_bytes() -> usize {
+    12000
+}
+const fn default_input_tokens() -> u64 {
+    16384
+}
+
+impl DecisionClassifierConfig {
+    pub(crate) fn api_key(&self) -> Result<Option<String>, AlgorithmConfigError> {
+        self.api_key_env
+            .as_ref()
+            .map(|name| {
+                if name.is_empty()
+                    || !name.bytes().enumerate().all(|(i, b)| {
+                        b == b'_' || b.is_ascii_alphabetic() || (i > 0 && b.is_ascii_digit())
+                    })
+                {
+                    return Err(AlgorithmConfigError::new(
+                        "decision_api api_key_env must name an environment variable",
+                    ));
+                }
+                let key = std::env::var(name).map_err(|_| {
+                    AlgorithmConfigError::new(format!(
+                        "decision_api credential environment variable {name} is not set"
+                    ))
+                })?;
+                if key.trim().is_empty() {
+                    return Err(AlgorithmConfigError::new(format!(
+                        "decision_api credential environment variable {name} is empty"
+                    )));
+                }
+                Ok(key)
+            })
+            .transpose()
+    }
+
+    fn endpoint(&self) -> Result<reqwest::Url, AlgorithmConfigError> {
+        let mut url = reqwest::Url::parse(&self.base_url).map_err(|_| {
+            AlgorithmConfigError::new("decision_api base_url must be an absolute HTTP(S) URL")
+        })?;
+        if !matches!(url.scheme(), "http" | "https")
+            || url.host_str().is_none()
+            || !url.username().is_empty()
+            || url.password().is_some()
+            || url.query().is_some()
+            || url.fragment().is_some()
+        {
+            return Err(AlgorithmConfigError::new(
+                "decision_api base_url must be HTTP(S) without credentials, query or fragment",
+            ));
+        }
+        let path = url.path().trim_end_matches('/');
+        let path = if path.ends_with("/v1/systemone") {
+            path.to_owned()
+        } else if path.ends_with("/v1") {
+            format!("{path}/systemone")
+        } else {
+            format!("{path}/v1/systemone")
+        };
+        url.set_path(&path);
+        Ok(url)
+    }
+
+    fn validate(&self) -> Result<(), AlgorithmConfigError> {
+        let threshold = self.efficient_threshold.unwrap_or(default_threshold());
+        if !threshold.is_finite() || threshold <= 0.5 || threshold > 1.0 {
+            return Err(AlgorithmConfigError::new(
+                "decision_api efficient_threshold must be greater than 0.5 and at most 1",
+            ));
+        }
+        if self.timeout_ms == 0 || self.timeout_ms > 60000 {
+            return Err(AlgorithmConfigError::new(
+                "decision_api timeout_ms must be between 1 and 60000",
+            ));
+        }
+        if self.max_request_bytes == 0
+            || self.max_request_bytes > 65536
+            || self.max_input_tokens == 0
+        {
+            return Err(AlgorithmConfigError::new(
+                "decision_api input limits must be positive; max_request_bytes must be at most 65536",
+            ));
+        }
+        if self.recent_turn_window > 64 {
+            return Err(AlgorithmConfigError::new(
+                "decision_api recent_turn_window must be at most 64",
+            ));
+        }
+        if self.classify_trigger == ClassifyTrigger::EveryRequest {
+            return Err(AlgorithmConfigError::new(
+                "decision_api classify_trigger must be user_turn or new_session",
+            ));
+        }
+        for (name, value) in [
+            ("model", &self.model),
+            ("instructions", &self.instructions),
+            ("uncertain_criteria", &self.uncertain_criteria),
+        ] {
+            if value.trim().is_empty() {
+                return Err(AlgorithmConfigError::new(format!(
+                    "decision_api {name} must not be empty"
+                )));
+            }
+        }
+        if self.choices.is_empty() {
+            if self.efficient_criteria.trim().is_empty() || self.capable_criteria.trim().is_empty()
+            {
+                return Err(AlgorithmConfigError::new(
+                    "decision_api requires efficient_criteria and capable_criteria, or choices",
+                ));
+            }
+        } else {
+            if self.choices.len() < 2 || self.choices.contains_key("uncertain") {
+                return Err(AlgorithmConfigError::new(
+                    "decision_api choices requires at least two options; uncertain is reserved",
+                ));
+            }
+            if self.efficient_threshold.is_some()
+                || !self.efficient_criteria.is_empty()
+                || !self.capable_criteria.is_empty()
+            {
+                return Err(AlgorithmConfigError::new(
+                    "decision_api choices cannot be combined with legacy efficient/capable settings",
+                ));
+            }
+            for (name, choice) in &self.choices {
+                if name.trim().is_empty()
+                    || choice.target.trim().is_empty()
+                    || choice.criteria.trim().is_empty()
+                    || !choice.min_probability.is_finite()
+                    || !(0.0..=1.0).contains(&choice.min_probability)
+                {
+                    return Err(AlgorithmConfigError::new(
+                        "decision_api choices require names, targets, criteria and min_probability in [0, 1]",
+                    ));
+                }
+            }
+        }
+        Ok(())
+    }
+
+    fn criteria(&self) -> BTreeMap<String, String> {
+        if self.choices.is_empty() {
+            BTreeMap::from([
+                ("efficient".into(), self.efficient_criteria.clone()),
+                ("capable".into(), self.capable_criteria.clone()),
+                ("uncertain".into(), self.uncertain_criteria.clone()),
+            ])
+        } else {
+            let mut criteria: BTreeMap<_, _> = self
+                .choices
+                .iter()
+                .map(|(name, choice)| (name.clone(), choice.criteria.clone()))
+                .collect();
+            criteria.insert("uncertain".into(), self.uncertain_criteria.clone());
+            criteria
+        }
+    }
+}
+
+pub(crate) struct DecisionClassifier {
+    config: DecisionClassifierConfig,
+    endpoint: reqwest::Url,
+    client: reqwest::Client,
+    api_key: Option<String>,
+    targets: BTreeMap<String, ModelId>,
+}
+
+#[derive(Deserialize)]
+struct DecisionResponse {
+    model: String,
+    answers: BTreeMap<String, ChoiceAnswer>,
+    usage: DecisionUsage,
+}
+#[derive(Deserialize)]
+struct DecisionUsage {
+    input_tokens: u64,
+    output_tokens: u64,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct ChoiceAnswer {
+    #[serde(rename = "type")]
+    kind: String,
+    choice: String,
+    confidence: f64,
+    probabilities: BTreeMap<String, f64>,
+}
+
+impl DecisionClassifier {
+    pub(crate) fn new(
+        config: DecisionClassifierConfig,
+        targets: &BTreeMap<String, ModelId>,
+    ) -> Result<Self, AlgorithmConfigError> {
+        config.validate()?;
+        let targets = config
+            .choices
+            .iter()
+            .map(|(name, choice)| {
+                targets
+                    .get(&choice.target)
+                    .cloned()
+                    .map(|target| (name.clone(), target))
+                    .ok_or_else(|| {
+                        AlgorithmConfigError::new(format!(
+                            "decision_api choice {name} refers to unknown target {}",
+                            choice.target
+                        ))
+                    })
+            })
+            .collect::<Result<BTreeMap<_, _>, _>>()?;
+        let endpoint = config.endpoint()?;
+        let api_key = config.api_key()?;
+        let client = reqwest::Client::builder()
+            .timeout(Duration::from_millis(config.timeout_ms))
+            .redirect(reqwest::redirect::Policy::none())
+            .build()
+            .map_err(|_| {
+                AlgorithmConfigError::new("could not initialize decision_api HTTP client")
+            })?;
+        Ok(Self {
+            config,
+            endpoint,
+            client,
+            api_key,
+            targets,
+        })
+    }
+
+    fn payload(&self, request: &Request) -> Result<Vec<u8>, &'static str> {
+        let llm = &request.llm_request;
+        let opening = llm
+            .messages
+            .iter()
+            .position(|m| m.role == Role::User)
+            .ok_or("missing_task")?;
+        let start = llm
+            .messages
+            .len()
+            .saturating_sub(self.config.recent_turn_window)
+            .max(opening + 1);
+        let indices = std::iter::once(opening).chain(start..llm.messages.len());
+        let mut messages = Vec::new();
+        for index in indices {
+            let message = &llm.messages[index];
+            let content = sanitized(&message.content)?;
+            if !content.is_empty() {
+                messages.push(json!({"role":message.role,"content":content}));
+            }
+        }
+        let mut instructions = Vec::new();
+        for instruction in &llm.instructions {
+            instructions
+                .push(json!({"role":instruction.role,"content":sanitized(&instruction.content)?}));
+        }
+        // System/developer messages can appear in messages rather than instructions.
+        for message in &llm.messages[..opening] {
+            if matches!(message.role, Role::System | Role::Developer) {
+                instructions
+                    .push(json!({"role":message.role,"content":sanitized(&message.content)?}));
+            }
+        }
+        let payload = json!({
+            "model":self.config.model,
+            "state":{
+                "client_instructions":instructions,
+                "messages":messages,
+                "available_tools":llm.tools.iter().map(|tool| &tool.name).collect::<Vec<_>>(),
+            },
+            "questions":{ QUESTION: {
+                "type":"choice",
+                "instructions":self.config.instructions,
+                "criteria":self.config.criteria()
+            }}
+        });
+        let body = serde_json::to_vec(&payload).map_err(|_| "invalid_input")?;
+        if body.len() > self.config.max_request_bytes {
+            return Err("input_too_large");
+        }
+        Ok(body)
+    }
+
+    async fn verdict(&self, body: Vec<u8>) -> Result<ChoiceAnswer, &'static str> {
+        let mut request = self
+            .client
+            .post(self.endpoint.clone())
+            .header("content-type", "application/json")
+            .body(body);
+        if let Some(key) = &self.api_key {
+            request = request.bearer_auth(key);
+        }
+        let mut response = request.send().await.map_err(|e| {
+            if e.is_timeout() {
+                "timeout"
+            } else {
+                "transport"
+            }
+        })?;
+        if !response.status().is_success() {
+            return Err("http_error");
+        }
+        if response
+            .content_length()
+            .is_some_and(|n| n > MAX_RESPONSE_BYTES as u64)
+        {
+            return Err("response_too_large");
+        }
+        let mut bytes = Vec::new();
+        while let Some(chunk) = response.chunk().await.map_err(|e| {
+            if e.is_timeout() {
+                "timeout"
+            } else {
+                "transport"
+            }
+        })? {
+            if bytes.len() + chunk.len() > MAX_RESPONSE_BYTES {
+                return Err("response_too_large");
+            }
+            bytes.extend_from_slice(&chunk);
+        }
+        let verdict: DecisionResponse =
+            serde_json::from_slice(&bytes).map_err(|_| "invalid_response")?;
+        if verdict.model != self.config.model
+            || verdict.answers.len() != 1
+            || verdict.usage.output_tokens != 0
+            || verdict.usage.input_tokens == 0
+            || verdict.usage.input_tokens >= self.config.max_input_tokens
+        {
+            return Err("invalid_response");
+        }
+        let answer = verdict
+            .answers
+            .into_iter()
+            .find(|(k, _)| k == QUESTION)
+            .ok_or("invalid_response")?
+            .1;
+        let options = self.config.criteria();
+        validate_answer(&answer, options.keys().map(String::as_str))?;
+        Ok(answer)
+    }
+}
+
+// Reasoning and opaque/media payloads do not cross into this text-only classifier.
+// Unsupported input or oversized preserved context defaults capable, never a
+// truncated or misleading efficient forecast. Answer requests retain all input.
+fn sanitized(blocks: &[ContentBlock]) -> Result<Vec<Value>, &'static str> {
+    let mut result = Vec::new();
+    for block in blocks {
+        match block {
+            ContentBlock::Reasoning { .. } => {}
+            ContentBlock::Text { .. }
+            | ContentBlock::Refusal { .. }
+            | ContentBlock::ToolCall(_) => {
+                result.push(serde_json::to_value(block).map_err(|_| "invalid_input")?);
+            }
+            ContentBlock::ToolResult(tool) => {
+                result.push(
+                    json!({"type":"tool_result","tool_call_id":tool.tool_call_id,
+                    "content":sanitized(&tool.content)?,"is_error":tool.is_error}),
+                );
+            }
+            _ => return Err("unsupported_input"),
+        }
+    }
+    Ok(result)
+}
+
+// SystemOne serving stacks can normalize `confidence` above chance or by entropy.
+// It is metadata, not the selected option's probability. Policy uses probabilities.
+fn validate_answer<'a>(
+    answer: &ChoiceAnswer,
+    options: impl Iterator<Item = &'a str>,
+) -> Result<(), &'static str> {
+    let options: Vec<_> = options.collect();
+    let valid_probability = |p: f64| p.is_finite() && (0.0..=1.0).contains(&p);
+    if answer.kind != "choice"
+        || !options.contains(&answer.choice.as_str())
+        || answer.probabilities.len() != options.len()
+        || options
+            .iter()
+            .any(|key| !answer.probabilities.contains_key(*key))
+        || !valid_probability(answer.confidence)
+        || answer
+            .probabilities
+            .values()
+            .any(|p| !valid_probability(*p))
+    {
+        return Err("invalid_distribution");
+    }
+    let sum_tolerance = ROUNDING_TOLERANCE.max(options.len() as f64 * 0.00005 + 1e-9);
+    if (answer.probabilities.values().sum::<f64>() - 1.0).abs() > sum_tolerance
+        || answer
+            .probabilities
+            .values()
+            .any(|p| *p > answer.probabilities[&answer.choice] + ROUNDING_TOLERANCE)
+    {
+        return Err("invalid_distribution");
+    }
+    Ok(())
+}
+
+#[async_trait]
+impl Classifier<State> for DecisionClassifier {
+    async fn score(
+        &self,
+        _state: &mut State,
+        request: &mut Request,
+        driver: &Driver,
+    ) -> libsy::Result<(Classification, Option<switchyard_protocol::Response>)> {
+        let started = Instant::now();
+        let result = match self.payload(request) {
+            Ok(body) => self.verdict(body).await,
+            Err(reason) => Err(reason),
+        };
+        let mut selected_target = None;
+        let category = match result {
+            Ok(answer) => {
+                let efficient = if self.config.choices.is_empty() {
+                    let threshold = self
+                        .config
+                        .efficient_threshold
+                        .unwrap_or(default_threshold());
+                    driver.set_evidence_if_empty(json!({"source":"decision_api","choice":answer.choice,
+                        "efficient_probability":answer.probabilities["efficient"],"efficient_threshold":threshold}));
+                    answer.choice == "efficient" && answer.probabilities["efficient"] >= threshold
+                } else {
+                    let choice = self.config.choices.get(&answer.choice);
+                    let accepted = choice.is_some_and(|choice| {
+                        answer.probabilities[&answer.choice] >= choice.min_probability
+                    });
+                    if accepted {
+                        selected_target = self.targets.get(&answer.choice).cloned();
+                    }
+                    driver.set_evidence_if_empty(json!({"source":"decision_api","choice":answer.choice,
+                        "probabilities":answer.probabilities,
+                        "min_probability":choice.map(|choice| choice.min_probability),
+                        "accepted":accepted,"selected_target":selected_target.as_ref().or_else(||driver.models_for(&Category::Capable).first())}));
+                    accepted
+                };
+                if efficient {
+                    Category::Efficient
+                } else {
+                    Category::Capable
+                }
+            }
+            Err(reason) => {
+                tracing::warn!(
+                    reason_code = reason,
+                    "Decision classifier unavailable; using capable default"
+                );
+                driver.set_evidence_if_empty(json!({"source":"fail_open","reason_code":reason}));
+                Category::Capable
+            }
+        };
+        let Some(target) =
+            selected_target.or_else(|| driver.models_for(&category).first().cloned())
+        else {
+            return Ok((Classification::Ambiguous(Vec::new()), None));
+        };
+        tracing::info!(
+            event = "decision_api_classified",
+            selected_target = %target,
+            elapsed_ms = started.elapsed().as_millis() as u64,
+        );
+        Ok((
+            Classification::Scores(vec![Score {
+                target,
+                confidence: 1.0,
+                category: Some(category),
+            }]),
+            None,
+        ))
+    }
+}
