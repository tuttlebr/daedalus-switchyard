+/// A named decision option mapped to an answering target.
+#[derive(Clone, Debug, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct DecisionTargetConfig {
+    /// Answering target name from the TOML targets table.
+    pub target: String,
+    /// Tasks for which this target is sufficient.
+    pub criteria: String,
+    /// Minimum probability of the winning option. Lower scores use the stage capable target.
