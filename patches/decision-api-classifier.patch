+impl<'de> Deserialize<'de> for CompositeClassifierConfig {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let mut table = toml::Table::deserialize(deserializer)?;
+        let kind = table.remove("type");
+        match kind.as_ref().and_then(toml::Value::as_str) {
+            None if kind.is_none() => StageClassifierConfig::deserialize(toml::Value::Table(table))
