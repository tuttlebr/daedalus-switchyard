+#[cfg(test)]
+mod tests {
+    use super::*;
+    use switchyard_protocol::{LlmRequest, Message};
+
+    fn config() -> DecisionClassifierConfig {
+        toml::from_str(
+            r#"
+base_url = "http://localhost:30000/v1"
+model = "Cloudflare/clef-flash"
+instructions = "Judge whole-task effort, preserving exact output constraints."
+efficient_criteria = "Narrow, clear routine tasks at GLM medium."
+capable_criteria = "Complex tasks at GLM xhigh."
+uncertain_criteria = "Missing or ambiguous context."
+"#,
+        )
+        .unwrap()
+    }
+
+    #[test]
+    fn decision_request_preserves_task_context_but_excludes_private_reasoning() {
+        let mut c = config();
+        c.recent_turn_window = 2;
+        let classifier = DecisionClassifier::new(c, &BTreeMap::new()).unwrap();
+        let request = Request {
+            llm_request: LlmRequest {
+                messages: vec![
+                    Message::text(Role::System, "required permissions"),
+                    Message::text(Role::User, "opening task"),
+                    Message::text(Role::Assistant, "old response outside window"),
+                    Message {
+                        role: Role::Assistant,
+                        content: vec![ContentBlock::Reasoning {
+                            text: "PRIVATE_REASONING".into(),
+                            signature: Some("PRIVATE_SIGNATURE".into()),
+                            details: vec![],
+                        }],
+                    },
+                    Message::text(Role::User, "latest update"),
+                ],
+                ..Default::default()
+            },
+            ..Default::default()
+        };
+        let body = String::from_utf8(classifier.payload(&request).unwrap()).unwrap();
+        assert!(body.contains("opening task"));
+        assert!(body.contains("latest update"));
+        assert!(body.contains("required permissions"));
+        assert!(!body.contains("old response outside window"));
+        assert!(!body.contains("PRIVATE_REASONING"));
+        assert!(!body.contains("PRIVATE_SIGNATURE"));
+        let payload: Value = serde_json::from_str(&body).unwrap();
+        assert!(
+            payload["questions"][QUESTION]["instructions"]
+                .as_str()
+                .unwrap()
+                .contains("exact output constraints")
+        );
+    }
+
+    #[test]
+    fn native_config_rejects_unsafe_or_invalid_settings() {
+        for url in [
+            "file:///etc/passwd",
+            "http://user:secret@localhost",
+            "http://localhost?token=secret",
+            "http://localhost/#fragment",
+            "relative",
+        ] {
+            let mut c = config();
+            c.base_url = url.into();
+            assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+        }
+        for threshold in [f64::NAN, 0.5, -1.0, 1.1] {
+            let mut c = config();
+            c.efficient_threshold = Some(threshold);
+            assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+        }
+        let mut c = config();
+        c.timeout_ms = 0;
+        assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+        let mut c = config();
+        c.classify_trigger = ClassifyTrigger::EveryRequest;
+        assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+        let mut c = config();
+        c.recent_turn_window = 65;
+        assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+        let mut c = config();
+        c.api_key_env = Some("INVALID-ENV".into());
+        assert!(DecisionClassifier::new(c, &BTreeMap::new()).is_err());
+    }
+
+    #[test]
+    fn named_choices_require_valid_targets_and_reject_legacy_mixing() {
+        let mut c = config();
+        c.efficient_criteria.clear();
+        c.capable_criteria.clear();
+        c.choices = BTreeMap::from([
+            (
+                "routine".into(),
+                DecisionTargetConfig {
+                    target: "small".into(),
+                    criteria: "Routine tasks.".into(),
+                    min_probability: 0.9,
+                },
+            ),
+            (
+                "complex".into(),
+                DecisionTargetConfig {
+                    target: "large".into(),
+                    criteria: "Complex tasks.".into(),
+                    min_probability: 0.9,
+                },
+            ),
+        ]);
+        let targets = BTreeMap::from([
+            ("small".into(), ModelId::from("small-id")),
+            ("large".into(), ModelId::from("large-id")),
+        ]);
+        assert!(DecisionClassifier::new(c.clone(), &targets).is_ok());
+        assert!(DecisionClassifier::new(c.clone(), &BTreeMap::new()).is_err());
+        let mut mixed = c.clone();
+        mixed.efficient_threshold = Some(0.9);
+        assert!(DecisionClassifier::new(mixed, &targets).is_err());
+        let mut reserved = c.clone();
+        let choice = reserved.choices.remove("routine").unwrap();
+        reserved.choices.insert("uncertain".into(), choice);
+        assert!(DecisionClassifier::new(reserved, &targets).is_err());
+        for probability in [f64::NAN, -0.1, 1.1] {
+            let mut invalid = c.clone();
+            invalid.choices.get_mut("routine").unwrap().min_probability = probability;
+            assert!(DecisionClassifier::new(invalid, &targets).is_err());
+        }
+    }
+
+    #[test]
+    fn named_probability_validation_scales_with_the_choice_count() {
+        let probabilities: BTreeMap<String, f64> =
+            (0..18).map(|i| (i.to_string(), 0.0556)).collect();
+        let answer = ChoiceAnswer {
+            kind: "choice".into(),
+            choice: "0".into(),
+            confidence: 0.0,
+            probabilities,
+        };
+        assert!(validate_answer(&answer, answer.probabilities.keys().map(String::as_str)).is_ok());
+        assert!(validate_answer(&answer, ["other"].into_iter()).is_err());
+    }
+}
