+/// Keeps a judge-selected task target as the floor for efficient stage decisions.
+pub(crate) fn set_task_target(state: &mut State, target: &switchyard_protocol::ModelId) {
+    state.extra.insert(
+        TASK_TARGET_KEY.into(),
+        StateValue::String(target.to_string()),
+    );
+}
+
+pub(crate) fn task_target(state: &State, driver: &Driver) -> Option<switchyard_protocol::ModelId> {
+    let StateValue::String(target) = state.extra.get(TASK_TARGET_KEY)? else {
+        return None;
+    };
+    driver
+        .models_for(&Category::Any)
+        .iter()
+        .find(|candidate| candidate.as_str() == target)
+        .cloned()
+}
 
