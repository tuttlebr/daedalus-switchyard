     #[test]
+    fn sglang_metadata_is_optional_and_does_not_change_choice_probabilities() {
+        let mut value = json!({"type":"choice", "choice":"low", "confidence":0.99,
+            "probabilities":{"low":0.99,"high":0.01}});
+        for mass in [None, Some(0.0), Some(0.2), Some(1.0)] {
+            if let Some(mass) = mass {
+                value["x_label_mass"] = json!(mass);
+            }
+            let answer: ChoiceAnswer = serde_json::from_value(value.clone()).unwrap();
+            assert_eq!(answer.x_label_mass, mass);
+            assert!(validate_answer(&answer, ["low", "high"].into_iter()).is_ok());
+            assert_eq!(answer.probabilities["low"], 0.99);
+        }
+        value["unexpected"] = json!(0.5);
+        assert!(serde_json::from_value::<ChoiceAnswer>(value).is_err());
+    }
+
+    #[test]
+    fn malformed_sglang_metadata_is_rejected() {
+        let mut value = json!({"type":"choice", "choice":"low", "confidence":0.99,
+            "probabilities":{"low":0.99,"high":0.01}});
+        for mass in [json!("0.5"), json!(true), json!({})] {
+            value["x_label_mass"] = mass;
+            assert!(serde_json::from_value::<ChoiceAnswer>(value.clone()).is_err());
+        }
+        value["x_label_mass"] = json!(0.5);
+        let mut answer: ChoiceAnswer = serde_json::from_value(value).unwrap();
+        for mass in [-0.1, 1.1, f64::NAN, f64::INFINITY] {
+            answer.x_label_mass = Some(mass);
+            assert!(validate_answer(&answer, ["low", "high"].into_iter()).is_err());
+        }
+    }
