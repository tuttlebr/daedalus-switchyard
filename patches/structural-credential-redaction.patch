+    #[test]
+    fn serialized_redaction_does_not_match_across_json_escape_boundaries() {
+        let redactor = ProviderKeyRedactor::new(&["nabc".into(), "u1234".into()]);
+        let original = r#"{"text":"before\nabc after\u1234","credential":"nabc"}"#;
+        let sanitized: Value = serde_json::from_str(&redactor.json(original.into())).unwrap();
+        assert_eq!(sanitized["text"], "before\nabc after\u{1234}");
+        assert_eq!(sanitized["credential"], "[REDACTED]");
+        let unchanged = r#"{ "text": "before\nabc after\u1234" }"#;
+        assert_eq!(redactor.json(unchanged.into()), unchanged);
+    }
+
