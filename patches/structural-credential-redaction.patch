+            "usage":{"count":1234,"enabled":true,"disabled":false,"missing":null},
+            "credential":"nabc",
+        });
+        let sanitized: Value = serde_json::from_str(&redactor.json(event.to_string())).unwrap();
+        assert_eq!(sanitized["text"], event["text"]);
+        assert_eq!(sanitized["usage"], event["usage"]);
+        assert_eq!(sanitized["credential"], "[REDACTED]");
