 // Overwrites the outbound body's `model` field with the resolved model id.
+// Fireworks accepts historical thinking as `reasoning_content`, while the generic
+// Chat encoder emits `reasoning`. Preserve the text on tool continuations without
+// changing other providers' representations or discarding opaque reasoning.
+fn normalize_fireworks_chat_reasoning(body: &mut Value, backend: &Backend) -> Result<()> {
+    let fireworks_model = body
+        .get("model")
+        .and_then(Value::as_str)
+        .is_some_and(|model| model.starts_with("accounts/fireworks/"));
+    let fireworks_host = reqwest::Url::parse(&backend.url())
+        .ok()
+        .is_some_and(|url| url.host_str() == Some("api.fireworks.ai"));
+    if !fireworks_model && !fireworks_host {
+        return Ok(());
+    }
+    let Some(messages) = body.get_mut("messages").and_then(Value::as_array_mut) else {
+        return Ok(());
+    };
+    for message in messages {
+        let Some(message) = message.as_object_mut() else {
+            continue;
+        };
+        if message.get("role").and_then(Value::as_str) != Some("assistant") {
+            continue;
+        }
+        if let Some(details) = message.remove("reasoning_details") {
+            if !details.is_null() && details != json!([]) {
+                return Err(LlmClientError::InvalidRequest {
+                    message: "Fireworks Chat cannot represent structured reasoning details"
+                        .to_string(),
+                });
+            }
+        }
+        let Some(reasoning) = message.remove("reasoning") else {
+            continue;
+        };
+        if reasoning.is_null() {
+            continue;
+        }
+        if !reasoning.is_string() {
+            return Err(LlmClientError::InvalidRequest {
+                message: "Fireworks Chat requires plaintext reasoning_content".to_string(),
+            });
+        }
+        if let Some(existing) = message.get("reasoning_content") {
+            if !existing.is_null() && existing != &reasoning {
+                return Err(LlmClientError::InvalidRequest {
+                    message: "Fireworks Chat received conflicting reasoning fields".to_string(),
+                });
+            }
+        }
+        message.insert("reasoning_content".to_string(), reasoning);
+    }
+    Ok(())
+}
