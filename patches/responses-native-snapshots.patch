+// Native Responses consumers can reconcile authoritative snapshots. Translated
+// append-only consumers must continue to fail rather than silently corrupt text.
+#[test]
+fn responses_native_snapshot_corrections_replay_through_completion() -> TestResult {
+    let engine = TranslationEngine::default();
+    let source = WireFormat::OpenAiResponses;
+    for include_item in [false, true] {
+        for tool in [false, true] {
+            let item = if tool {
+                json!({"type":"function_call", "id":"fc_1", "call_id":"call_1",
+                    "name":"clock", "arguments":"{}"})
+            } else {
+                json!({"type":"message", "id":"msg_1", "role":"assistant",
+                    "content":[{"type":"output_text", "text":"Corrected 雪🌲"}]})
+            };
+            let mut events = vec![json!({"type":"response.created",
+                "response":{"id":"resp_1", "model":"fixture"}})];
+            if tool {
+                events.push(json!({"type":"response.output_item.added", "output_index":0,
+                    "item":{"type":"function_call", "id":"fc_1", "call_id":"call_1",
+                    "name":"clock", "arguments":""}}));
+            }
+            events.push(json!({"type":if tool {"response.function_call_arguments.delta"}
+                else {"response.output_text.delta"}, "output_index":0, "content_index":0,
+                "delta":if tool {"{\"discard\":true}"} else {"Provisional too long"}}));
+            if include_item {
+                events.push(json!({"type":"response.output_item.done", "output_index":0,
+                    "item":item}));
+            }
+            events.push(json!({"type":"response.completed", "response":{
+                "id":"resp_1", "model":"fixture", "status":"completed", "output":[item],
+                "usage":{"input_tokens":7,"output_tokens":3,"total_tokens":10}}}));
+            for target in [source, WireFormat::OpenAiChat, WireFormat::AnthropicMessages] {
+                let mut decoder = StreamTranslationState::new(source, target);
+                let mut encoder = StreamTranslationState::new(source, target);
+                let mut output = Vec::new();
+                for event in &events {
+                    let decoded = engine.decode_stream_event(&mut decoder, source, event.clone())?;
+                    output.extend(engine.encode_stream_event(&mut encoder, target, decoded)?);
+                }
+                output.extend(engine.finish_stream(&mut encoder, target)?);
+                if target == source {
+                    assert_eq!(output, events);
+                } else {
+                    assert!(output.last().unwrap()["error"]["message"].is_string(), "{output:?}");
+                }
+            }
+        }
+    }
+    Ok(())
+}
