+// SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+//! Process-local task assignments. Only opaque keys and configured target IDs are retained.
+
+use std::collections::{HashMap, VecDeque};
+use std::hash::{BuildHasher, Hash, Hasher, RandomState};
+use std::io::{self, Write};
+use std::sync::{Arc, Mutex};
+
+use switchyard_protocol::{ContentBlock, ModelId, Request, Role};
+use tokio::sync::OnceCell;
+
+const CAPACITY: usize = 4096;
+type Slot = Arc<OnceCell<Assignment>>;
+
+pub(super) struct Assignment {
+    pub(super) target: ModelId,
+    // The only fallback is the configured default. A serving receipt for it supersedes
+    // any later-arriving acknowledgment of an earlier primary in this task.
+    served_default: bool,
+}
+
+impl Assignment {
+    pub(super) fn classified(target: ModelId) -> Self {
+        Self {
+            target,
+            served_default: false,
+        }
+    }
+
+    fn served(target: &ModelId, default: &ModelId) -> Self {
+        Self {
+            target: target.clone(),
+            served_default: target == default,
+        }
+    }
+}
+
+#[derive(Default)]
+struct Entries {
+    by_key: HashMap<u64, Slot>,
+    insertion_order: VecDeque<u64>,
+}
+
+pub(super) struct TaskKey {
+    hash: u64,
+    // Without a task/turn ID, a user-ended request can be a new, identical task.
+    opens_user_turn: bool,
+}
+
+#[derive(Default)]
+pub(super) struct TaskAssignments {
+    hash: RandomState,
+    entries: Mutex<Entries>,
+}
+
+impl TaskAssignments {
+    pub(super) fn key(&self, request: &Request) -> Option<TaskKey> {
+        let metadata = request.metadata.as_ref()?;
+        let session = metadata.session_id.as_deref().filter(|id| !id.is_empty());
+        let task = metadata.task_id.as_deref().filter(|id| !id.is_empty());
+        if task.is_none() && session.is_none() {
+            return None;
+        }
+        if metadata.is_subagent && metadata.agent_id.as_deref().is_none_or(str::is_empty) {
+            return None;
+        }
+        let mut hash = self.hash.build_hasher();
+        session.hash(&mut hash);
+        metadata.is_subagent.hash(&mut hash);
+        metadata.agent_id.hash(&mut hash);
+        // Separate callers that choose the same session or task ID. Keep credential bytes
+        // out of the assignment table and routing evidence.
+        if let Some(headers) = &metadata.http_headers {
+            for name in ["authorization", "x-api-key", "api-key", "x-goog-api-key"] {
+                headers
+                    .get(name)
+                    .map(|value| value.as_bytes())
+                    .hash(&mut hash);
+            }
+        }
+        let mut opens_user_turn = false;
+        if let Some(task) = task {
+            (0u8, task).hash(&mut hash);
+        } else if let Some(turn) = metadata.turn_id.as_deref().filter(|id| !id.is_empty()) {
+            (1u8, turn).hash(&mut hash);
+        } else {
+            // A session can have overlapping continuations or retry an earlier turn. Include
+            // the real user turn, excluding tool results carried in Anthropic user envelopes.
+            let messages = &request.llm_request.messages;
+            let position = messages.iter().rposition(|m| {
+                m.role == Role::User
+                    && m.content
+                        .iter()
+                        .any(|block| !matches!(block, ContentBlock::ToolResult(_)))
+            })?;
+            opens_user_turn = position + 1 == messages.len();
+            2u8.hash(&mut hash);
+            serde_json::to_writer(HashWriter(&mut hash), &messages[..=position]).ok()?;
+        }
+        Some(TaskKey {
+            hash: hash.finish(),
+            opens_user_turn,
+        })
+    }
+
+    pub(super) fn slot(
+        &self,
+        key: TaskKey,
+        acknowledged: Option<&ModelId>,
+        default: &ModelId,
+    ) -> Slot {
+        let mut entries = self.entries.lock().unwrap();
+        if let Some(existing) = entries.by_key.get_mut(&key.hash) {
+            if let Some(served) = acknowledged
+                && existing.get().is_none_or(|entry| {
+                    !entry.served_default && (&entry.target != served || served == default)
+                })
+            {
+                *existing = Arc::new(OnceCell::from(Assignment::served(served, default)));
+            } else if acknowledged.is_none() && key.opens_user_turn && existing.initialized() {
+                *existing = Arc::new(OnceCell::new());
+            }
+            return Arc::clone(existing);
+        }
+        let slot = Arc::new(OnceCell::new_with(
+            acknowledged.map(|target| Assignment::served(target, default)),
+        ));
+        if entries.by_key.len() == CAPACITY {
+            // Never invalidate a task's pending decision while another request is waiting
+            // for it. An exceptional overflow of 4096 concurrent cold tasks runs uncached.
+            let Some(position) = entries.insertion_order.iter().position(|key| {
+                let slot = &entries.by_key[key];
+                slot.initialized() || Arc::strong_count(slot) == 1
+            }) else {
+                return slot;
+            };
+            let oldest = entries.insertion_order.remove(position).unwrap();
+            entries.by_key.remove(&oldest);
+        }
+        entries.insertion_order.push_back(key.hash);
+        entries.by_key.insert(key.hash, Arc::clone(&slot));
+        slot
+    }
+
+    pub(super) fn observe_fallback(&self, request: &Request, primary: &ModelId, served: &ModelId) {
+        if let Some(key) = self.key(request)
+            && let Some(slot) = self.entries.lock().unwrap().by_key.get_mut(&key.hash)
+            && slot
+                .get()
+                .is_some_and(|entry| &entry.target == primary || &entry.target == served)
+        {
+            *slot = Arc::new(OnceCell::from(Assignment {
+                target: served.clone(),
+                served_default: true,
+            }));
+        }
+    }
+}
+
+// Hash structured user input, including images, without allocating a copy of its payload.
+struct HashWriter<'a, H>(&'a mut H);
+impl<H: Hasher> Write for HashWriter<'_, H> {
+    fn write(&mut self, bytes: &[u8]) -> io::Result<usize> {
+        self.0.write(bytes);
+        Ok(bytes.len())
+    }
+    fn flush(&mut self) -> io::Result<()> {
+        Ok(())
+    }
+}
