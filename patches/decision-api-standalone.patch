+/// Stateless routing: tool continuations get the same fresh decision as user turns.
+/// Only the configured default is a provider fallback; other choices are not a cascade.
+pub(crate) struct DecisionRouter {
+    classifier: DecisionClassifier,
+    default_target: ModelId,
+}
+
+impl DecisionRouter {
+    pub(crate) fn new(
+        config: DecisionClassifierConfig,
+        targets: &BTreeMap<String, ModelId>,
+        default_target: ModelId,
+    ) -> Result<Self, AlgorithmConfigError> {
+        if config.classify_trigger != ClassifyTrigger::EveryRequest || config.choices.is_empty() {
+            return Err(AlgorithmConfigError::new(
+                "standalone decision_api requires named choices and classify_trigger = every_request",
+            ));
+        }
+        Ok(Self {
+            classifier: DecisionClassifier::new(config, targets)?,
+            default_target,
+        })
+    }
+}
+
+#[async_trait]
+impl Algorithm for DecisionRouter {
+    fn name(&self) -> &str {
+        "decision_api"
+    }
+
+    async fn route(
+        self: Arc<Self>,
+        driver: Driver,
+        mut request: Request,
+    ) -> libsy::Result<RoutingOutcome> {
+        let (classification, _) = self
+            .classifier
+            .score(&mut State::default(), &mut request, &driver)
+            .await?;
+        let target = classification
+            .argmax(false)?
+            .map_or_else(|| self.default_target.clone(), |score| score.target);
+        let fallbacks = if target == self.default_target {
+            Vec::new()
+        } else {
+            vec![self.default_target.clone()]
+        };
+        Ok(RoutingOutcome::route_to(target, fallbacks, request))
+    }
+}
