+    #[test]
+    fn fireworks_tool_schema_presence_keeps_constraints_and_literals() {
+        let presence = json!({"not": {"type": "null"}, "minLength": 1,
+            "pattern": "\\S", "minItems": 1, "minProperties": 1});
+        let typed = json!({"type": "string", "not": {"type": "null"}});
+        let mut schema = json!({
+            "type": "object",
+            "$defs": {"present": presence},
+            "properties": {
+                "not": presence,
+                "typed": typed,
+                "forbidden": false,
+                "ref": {"$ref": "#/$defs/present"},
+                "list": {"type": "array", "items": presence}
+            },
+            "oneOf": [{"required": ["query"], "properties": {"query": presence}}],
+            "allOf": [{"if": {"properties": {"operation": {"const": "search"}}},
+                "then": {"properties": {"query": presence}}}],
+            "default": presence, "const": presence, "enum": [presence], "examples": [presence]
+        });
+        let original = schema.clone();
+        normalize_fireworks_schema(&mut schema);
+        let mut expected = presence.clone();
+        expected["type"] = json!(["string", "number", "boolean", "object", "array"]);
+        for pointer in [
+            "/$defs/present",
+            "/properties/not",
+            "/properties/list/items",
+            "/oneOf/0/properties/query",
+            "/allOf/0/then/properties/query",
+        ] {
+            assert_eq!(schema.pointer(pointer), Some(&expected));
+        }
+        for key in ["default", "const", "enum", "examples"] {
+            assert_eq!(schema[key], original[key]);
+        }
+        assert_eq!(schema["properties"]["typed"], typed);
+        assert_eq!(schema["properties"]["forbidden"], false);
+        assert_eq!(schema["properties"]["ref"], original["properties"]["ref"]);
+        assert_eq!(schema["oneOf"][0]["required"], json!(["query"]));
+        assert!(schema["oneOf"][0].get("type").is_none());
+        assert!(schema["allOf"][0]["then"].get("type").is_none());
+        let once = schema.clone();
+        normalize_fireworks_schema(&mut schema);
+        assert_eq!(schema, once);
+    }
+
+    #[test]
+    fn fireworks_tool_schema_required_branches_keep_non_object_values() {
+        let mut schema = json!({
+            "type": "object",
+            "anyOf": [{"required": ["on"]}, {"required": ["brightness_percent"]}],
+            "not": {"required": ["color_xy", "color_temperature_kelvin"]},
+            "properties": {"required": {"type": "boolean"}},
+            "default": {"required": ["literal"]},
+            "examples": [{"required": ["literal"]}]
+        });
+        let original = schema.clone();
+        normalize_fireworks_schema(&mut schema);
+        let all_types = json!(["string", "number", "boolean", "object", "array", "null"]);
+        for pointer in ["/anyOf/0", "/anyOf/1", "/not"] {
+            let normalized = schema.pointer(pointer).unwrap();
+            assert_eq!(normalized["type"], all_types);
+            assert_eq!(
+                normalized["required"],
+                original.pointer(pointer).unwrap()["required"]
+            );
+        }
+        for key in ["type", "properties", "default", "examples"] {
+            assert_eq!(schema[key], original[key]);
+        }
+        let once = schema.clone();
+        normalize_fireworks_schema(&mut schema);
+        assert_eq!(schema, once);
+    }
