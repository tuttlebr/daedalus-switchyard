+
+fn normalize_fireworks_schema(schema: &mut Value) {
+    let Some(object) = schema.as_object_mut() else {
+        return;
+    };
+    // Fireworks needs an explicit type for presence and required-only schemas.
+    // `required` constrains objects but also accepts every non-object value.
+    // Keep that behavior inside anyOf, oneOf, and not by using all JSON types,
+    // excluding null only when an existing constraint already excludes it.
+    if !object.contains_key("type") {
+        if object.get("not") == Some(&json!({"type": "null"})) {
+            object.insert(
+                "type".to_string(),
+                json!(["string", "number", "boolean", "object", "array"]),
+            );
+        } else if object.contains_key("required")
+            && ![
+                "properties",
+                "$ref",
+                "enum",
+                "const",
+                "allOf",
+                "anyOf",
+                "oneOf",
+            ]
+            .iter()
+            .any(|key| object.contains_key(*key))
+        {
+            object.insert(
+                "type".to_string(),
+                json!(["string", "number", "boolean", "object", "array", "null"]),
+            );
+        }
+    }
+    // Visit only schema positions. Property names and literal values in
+    // defaults, const, enum, and examples are data, not schemas.
+    for key in [
+        "properties",
+        "patternProperties",
+        "$defs",
+        "definitions",
+        "dependentSchemas",
+        "dependencies",
+    ] {
+        if let Some(children) = object.get_mut(key).and_then(Value::as_object_mut) {
+            for child in children.values_mut() {
+                normalize_fireworks_schema(child);
+            }
+        }
+    }
+    for key in ["allOf", "anyOf", "oneOf", "prefixItems"] {
+        if let Some(children) = object.get_mut(key).and_then(Value::as_array_mut) {
+            for child in children {
+                normalize_fireworks_schema(child);
+            }
+        }
+    }
+    for key in [
+        "items",
+        "additionalItems",
+        "additionalProperties",
+        "unevaluatedItems",
+        "unevaluatedProperties",
+        "propertyNames",
+        "contains",
+        "not",
+        "if",
+        "then",
+        "else",
+    ] {
+        if let Some(child) = object.get_mut(key) {
+            if let Some(children) = child.as_array_mut() {
+                for child in children {
+                    normalize_fireworks_schema(child);
+                }
+            } else {
+                normalize_fireworks_schema(child);
+            }
+        }
+    }
 }
 
