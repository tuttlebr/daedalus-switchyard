+/// Baseten enforces max_len on the complete rendered question. Its wire budget
+/// is separate. Serialize the state as text so its nested tool messages and
+/// client instructions are data, not a provider-native conversation.
+fn baseten_payload(
+    body: &[u8],
+    max_tokens: u64,
+    max_bytes: usize,
+    truncate: bool,
+) -> Result<(Vec<u8>, bool), &'static str> {
+    let mut payload: Value = serde_json::from_slice(body).map_err(|_| "invalid_input")?;
+    let original = payload["state"].take();
+    payload["max_len"] = json!(max_tokens);
+    payload["state"] = Value::String(original.to_string());
+    let mut encoded = serde_json::to_vec(&payload).map_err(|_| "invalid_input")?;
+    if encoded.len() <= max_bytes {
+        return Ok((encoded, false));
+    }
+    if !truncate {
+        return Err("input_too_large");
+    }
+    let mut budget = max_bytes;
+    loop {
+        payload["state"] = Value::String(compact_state(&original, budget).to_string());
+        encoded = serde_json::to_vec(&payload).map_err(|_| "invalid_input")?;
+        if encoded.len() <= max_bytes {
+            return Ok((encoded, true));
+        }
+        if budget == 0 {
+            return Err("routing_question_too_large");
+        }
+        // Escaped JSON can expand excerpts. Recheck the actual wire size and
+        // reduce the allocation by at least a quarter to bound fitting work.
+        budget = budget.saturating_sub((encoded.len() - max_bytes).max(budget.div_ceil(4)));
+    }
+}
