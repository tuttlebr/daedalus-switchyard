+/// Mirrors the pinned SGLang generic SystemOne choice renderer used by Elephant.
+/// Tokenization applies the hosted model's chat template, not a local estimate.
+fn render_systemone_prompt(payload: &Value) -> Result<String, &'static str> {
+    let question = &payload["questions"][QUESTION];
+    let instructions = question["instructions"].as_str().ok_or("invalid_input")?;
+    let criteria = question["criteria"].as_object().ok_or("invalid_input")?;
+    if criteria.len() > 26 {
+        return Err("unsupported_tokenizer_format");
+    }
+    let mut prompt = serde_json::to_string(&payload["state"]).map_err(|_| "invalid_input")?;
+    prompt.push_str("\n\nQuestion: ");
+    prompt.push_str(instructions);
+    for (index, (name, value)) in criteria.iter().enumerate() {
+        prompt.push_str(&format!(
+            "\n{}: {name} - {}",
+            char::from(b'A' + index as u8),
+            value.as_str().ok_or("invalid_input")?
+        ));
+    }
+    prompt.push_str("\nAnswer with the letter of one option only.");
+    Ok(prompt)
+}
