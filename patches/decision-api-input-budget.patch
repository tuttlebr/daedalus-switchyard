+/// Keep typed message roles and both ends of each text excerpt. The answering
+/// request is never mutated. Whole routing instructions/options are outside state.
+fn compact_state(original: &Value, budget: usize) -> Value {
+    let messages = original["messages"].as_array().cloned().unwrap_or_default();
+    let weights: Vec<usize> = messages
+        .iter()
+        .enumerate()
+        .map(|(i, m)| {
+            if i == 0 || i + 2 >= messages.len() || m["role"] == "user" {
+                3
+            } else {
+                1
+            }
+        })
+        .collect();
+    let mut segments = vec![
+        (original["client_instructions"].to_string(), 1),
+        (original["available_tools"].to_string(), 1),
+    ];
+    segments.extend(
+        messages
+            .iter()
+            .zip(&weights)
+            .map(|(message, weight)| (message["content"].to_string(), *weight)),
+    );
+    // Redistribute unused shares from short fields to larger excerpts.
+    let mut allocated = vec![0usize; segments.len()];
+    let mut remaining = budget;
+    while remaining > 0 {
+        let total: usize = segments
+            .iter()
+            .zip(&allocated)
+            .filter(|((text, _), size)| text.len() > **size)
+            .map(|((_, weight), _)| *weight)
+            .sum();
+        if total == 0 {
+            break;
+        }
+        let round_budget = remaining;
+        for (index, (text, weight)) in segments.iter().enumerate() {
+            let share = (round_budget.saturating_mul(*weight) / total)
+                .max(1)
+                .min(text.len() - allocated[index])
+                .min(remaining);
+            allocated[index] += share;
+            remaining -= share;
+        }
+    }
+    let compact_messages: Vec<_> = messages.iter().enumerate().map(|(index, message)| {
+        json!({"role":message["role"],"content":excerpt(&segments[index + 2].0, allocated[index + 2])})
+    }).collect();
+    json!({
+        "context_truncated":true,
+        "client_instructions":excerpt(&segments[0].0, allocated[0]),
+        "messages":compact_messages,
+        "available_tools":excerpt(&segments[1].0, allocated[1]),
+    })
+}
+
+fn excerpt(text: &str, budget: usize) -> String {
+    const MARKER: &str = "\n[truncated]\n";
+    if text.len() <= budget {
+        return text.to_owned();
+    }
+    let keep = budget.saturating_sub(MARKER.len());
+    let mut head = keep / 2;
+    let mut tail = text.len().saturating_sub(keep - head);
+    while !text.is_char_boundary(head) {
+        head -= 1;
+    }
+    while !text.is_char_boundary(tail) {
+        tail += 1;
     }
+    format!("{}{MARKER}{}", &text[..head], &text[tail..])
 }
 
